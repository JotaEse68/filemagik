NEXT_PUBLIC_SITE_URL=https://filemagik.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_DESKTOP=
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_SITE_APPROVED=false
NEXT_PUBLIC_ADSENSE_CMP_VERIFIED=false

# Optional Google ad placements. Inactive until site approval and Google-certified TCF CMP.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_INCONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE=

# Search indexing verification tokens supplied by site owner
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Show reserved ad placements before connecting real banner storage / Supabase
NEXT_PUBLIC_AD_SPACES_PREVIEW=true

# Free version: advertising works without Supabase. All slots are reserved by default.
# Configure an image and destination together to show a clickable first-party banner.
FILEMAGIK_ADS_ENABLED=true
FILEMAGIK_AD_HOME_IMAGE=
FILEMAGIK_AD_HOME_URL=
FILEMAGIK_AD_HOME_ALT=
FILEMAGIK_AD_DESKTOP_IMAGE=
FILEMAGIK_AD_DESKTOP_URL=
FILEMAGIK_AD_DESKTOP_ALT=
FILEMAGIK_AD_MOBILE_IMAGE=
FILEMAGIK_AD_MOBILE_URL=
FILEMAGIK_AD_MOBILE_ALT=
FILEMAGIK_AD_INCONTENT_IMAGE=
FILEMAGIK_AD_INCONTENT_URL=
FILEMAGIK_AD_INCONTENT_ALT=
FILEMAGIK_AD_RESULT_IMAGE=
FILEMAGIK_AD_RESULT_URL=
FILEMAGIK_AD_RESULT_ALT=
